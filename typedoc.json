{
  "$schema": "https://typedoc.org/schema.json",
  "categoryOrder": [
    "Primitives",
    "Effects & Scheduling",
    "ReactiveList",
    "ReactiveMap",
    "ReactiveSet",
    "Utilities",
    "*"
  ],
  "cleanOutputDir": true,
  "customCss": "./assets/docs.css",
  "entryPoints": ["./src/index.ts"],
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "hideGenerator": true,
  "includeVersion": true,
  "out": "docs",
  "visibilityFilters": {}
}
