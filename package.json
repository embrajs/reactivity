{
  "name": "@embra/reactivity",
  "version": "0.1.0",
  "description": "A lightweight, ownership-based, composable and explicit reactivity system.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embrajs/reactivity.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "react": [
        "dist/react.d.cts"
      ],
      "debug": [
        "dist/debug.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./react": {
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      },
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      }
    },
    "./debug": {
      "require": {
        "types": "./dist/debug.d.cts",
        "default": "./dist/debug.cjs"
      },
      "import": {
        "types": "./dist/debug.d.mts",
        "default": "./dist/debug.mjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "ts-check": "tsc --noEmit",
    "ts-watch": "tsc --noEmit -w",
    "docs": "typedoc --options typedoc.json && biome format --write --config-path=biome.docs.json --files-ignore-unknown=true docs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --coverage.reportsDirectory='./docs/coverage'",
    "build": "node scripts/build.ts",
    "build:min": "NODE_ENV=production MINIFY=true node scripts/build.ts && echo '' && gzip-size dist/index.mjs dist/index.cjs",
    "release": "commit-and-tag-version"
  },
  "keywords": [
    "observable",
    "react",
    "reactive",
    "model",
    "frp",
    "functional-reactive-programming",
    "data flow"
  ],
  "author": {
    "name": "CRIMX",
    "email": "straybugs@gmail.com",
    "url": "https://github.com/crimx/"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@hyrious/dts": "^0.3.8",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@wopjs/gzip-size": "^0.1.5",
    "commit-and-tag-version": "^12.7.1",
    "esbuild": "^0.27.7",
    "typedoc": "^0.28.18",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.0.4"
  }
}
